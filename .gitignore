.idea
./.idea
/.idea/
./.idea/
.venv
.env
# ./data is the compose bind mount; the directory is committed (data/.gitkeep) so a
# clone owns it, and everything a run writes into it stays untracked. (atrium-project#69)
/data/*
!/data/.gitkeep
downloaded_inputs/

# A document's CSV log while it is being written (main.py swaps it into
# <doc>_log.csv when the document is done); left behind only by a killed run.
*.partial

# Python bytecode. Recursive (not root-anchored): running the suite otherwise
# litters every package dir and a `git add -A` silently commits it.
# Added for atrium-project#10 — nlp-enrich had the identical gap.
__pycache__/
*.py[cod]

# Coverage data artifact written by `pytest --cov`; never source.
# Swept into a commit by `git add -A` during atrium-project#10 Phase 6.
.coverage
.coverage.*
