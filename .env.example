# atrium-translator — the published environment contract (atrium-project#60).
#
# Copy to `.env` and edit. Per-run knobs (input paths, formats, vocabulary) live in
# config.txt instead; this file is for values that vary by DEPLOYMENT. This file is
# the COMPLETE ledger: every variable the api image reads, at the default that is in
# the CODE. The operator-facing subset across all five services is the table in the
# hub's docs/k8s_deployment.md; this file's layout is fixed by
# docs/templates/env.example.template in ufal/atrium-project.
#
# TAG LEGEND: [required] raises at startup without it · [secret] never a literal
# anywhere committed, use a k8s Secret · [operator] an ordinary deployment knob ·
# [algorithmic] changes what the service COMPUTES, not how it is deployed ·
# [build] read by compose/Dockerfile or baked at build time · [deprecated] · [unreachable]
#
# HOW THIS FILE REACHES THE PROCESS — the distinction that used to bite:
#
#   docker compose    → delivered. Both services declare `env_file: .env`, so
#                       everything below is injected into the container. Compose
#                       ALSO reads this file for ${VAR} substitution, which is a
#                       different mechanism: substitution fills in the compose
#                       file, injection fills in the container. Until
#                       atrium-project#60 only substitution happened, so a
#                       LOG_LEVEL or MAX_UPLOAD_MB set here was read by nobody
#                       while this header claimed compose picked it up.
#   python -m service.api / python main.py
#                     → NOT delivered. Nothing in this repo calls load_dotenv();
#                       running outside a container, export the variables
#                       yourself (`set -a; . ./.env; set +a`).
#   Kubernetes        → NOT delivered. Use the manifest's own env: block. See
#                       ufal/atrium-project docs/k8s_deployment.md.
#
# A shell export beats this file for PORT, TRANSLATION_URL, UDPIPE_URL and the
# ATRIUM_* provenance values, which docker-compose.yml also lists explicitly
# because compose itself needs them; every other variable here comes from the
# file only.
#
# BLANK IS NOT UNIVERSALLY "UNSET". ALLOWED_ORIGINS is the trap: a blank value parses
# to an EMPTY origin list and blocks every browser request, where omitting the line
# gives you `*` — so it ships commented below, not blank. The backing-service URLs are
# the safe case: blank there really does mean "use the LINDAT default."

# ── §0 Required before first start ─────────────────────────────────────────────
# None — this service starts with no variables set. The openai_compatible LLM
# backend needs LLM_API_KEY, but only when TRANSLATION_BACKEND selects it — see §5.

# ── §1 HTTP surface ─────────────────────────────────────────────────────────────
# [operator] Port the api service binds, and the port service/healthcheck.py probes
# inside the container. docker-compose.yml maps "${PORT:-8000}:${PORT:-8000}", so
# changing it here moves listener, published port and HEALTHCHECK together.
PORT=8000
# [operator] Bind address. Leave at 0.0.0.0: healthcheck.py always probes loopback and
# never reads HOST, so 127.0.0.1 gives a container that reports healthy and is
# unreachable from outside it. Ships commented, like the other four repos' §1 —
# the code default is already 0.0.0.0, so an active line here bought nothing and
# broke this template's own "§1 is byte-identical across all five" invariant
# (atrium-project#60).
# HOST=0.0.0.0
# [operator] CSV of CORS origins. Code default "*" (every origin). An EMPTY value is
# NOT the same as omitting the line — see the note above. Ships commented so an
# operator who leaves it alone gets the real code default, not a value frozen here;
# uncomment to narrow it for a real deployment.
# ALLOWED_ORIGINS=*
# [operator] Canonical upload limit. MAX_UPLOAD_BYTES is a DEPRECATED fallback kept
# for older callers (service/atrium_service.py prefers the MB form) — set this one.
# There is NO shared default across the five services; 50 is translator's own.
MAX_UPLOAD_MB=50
# [deprecated] Do not set. Kept only so older callers that exported it still work;
# MAX_UPLOAD_MB wins whenever both are present. Listed here so the contract is
# complete and the deprecation is discoverable, not to offer a second knob.
# MAX_UPLOAD_BYTES=
# [operator] Path the container's HEALTHCHECK probes; change only alongside the route.
# HEALTHCHECK_PATH=/health

# ── §2 Lifecycle ────────────────────────────────────────────────────────────────
# [operator] Seconds uvicorn waits for in-flight requests on SIGTERM. A single
# /translate chunk can legitimately run for minutes; raise this together with the
# deployment's grace period (see docs/k8s_deployment.md in the hub).
GRACEFUL_SHUTDOWN_S=20
# [operator] Root logger level for the `python -m service.api` start path. All five
# services honour it identically (atrium-project#61).
LOG_LEVEL=INFO
# [operator] Filesystem auto-reload — development only, never in a deployment.
# RELOAD=false

# ── §3 Backing services (atrium-project#63) ─────────────────────────────────────
# [operator] Attachable endpoints: point these at a self-hosted translation service or
# UDPipe 2, or at a local stub, with no code change. Leave BLANK (not deleted) to use
# the LINDAT defaults — blank means "unset" to every resolver, which is why
# docker-compose.yml passes them as ${VAR:-}.
#
# TRANSLATION_URL is the documented name; LINDAT_BASE_URL is accepted as an alias and
# loses to it when both are set. Whichever resolves is what /translate and the batch
# CLI record in the `translation_api` paradata field, so the record always names the
# host the request actually went to.
TRANSLATION_URL=
# [operator] Accepted alias for TRANSLATION_URL, kept for callers that already export
# it. TRANSLATION_URL wins when both are set. Prefer the name above.
# LINDAT_BASE_URL=
# [operator] Used for vocabulary lemma matching (Tag-and-Protect). Same variable name
# as atrium-nlp-enrich, which calls the same service for its own pipeline. Default is
# the LINDAT public UDPipe 2 endpoint (see docs/translation-backends.md).
UDPIPE_URL=

# ── §4 Image / provenance ────────────────────────────────────────────────────────
# [build] Image tag used by docker-compose (matches para_config.txt [tool] on release).
# Read only by docker-compose.yml; no Python here reads it.
ATRIUM_VERSION=dev
# [build] Baked at build time; stamped into paradata as runner_ref.
ATRIUM_RUNNER_REF=dev
# [build] Baked at build time; override either only if you publish under another name.
# ATRIUM_RUNNER_IMAGE=ghcr.io/ufal/atrium-translator:dev
# ATRIUM_RUNNER_REPO=https://github.com/ufal/atrium-translator
# [build] Correlation id copied verbatim into paradata `request_id`. Read ONCE from the
# process environment at import (atrium_paradata.py's module-level constants), so it
# identifies a batch run, not an individual HTTP request — do not expect
# per-request correlation from it.
# ATRIUM_REQUEST_ID=
# [build] Where the FastText language-ID model is cached. The Dockerfile sets this and
# docker-compose.yml mounts a named volume at it; without the volume the model is
# re-downloaded on every start and the service comes up DEGRADED on a host with no
# egress (see /health?deep=true).
# HF_HOME=/cache/huggingface

# ── §5 Service knobs — operator ──────────────────────────────────────────────────
# [operator] Which translation backend to load. `lindat` (CUBBITT) is the default;
# `openai_compatible` needs the LLM_* connection variables below, `ct2` the CT2_*
# ones. Shared with the CLI's --backend flag (issue #4).
TRANSLATION_BACKEND=lindat

# [operator] How a translation is written into the document — the issue #46
# "replace vs append" question, exposed as a switch rather than baked in.
#   replace  (default) overwrite the source-language field. The artifact is a
#            monolingual mirror; the Czech survives only in the sidecar _log.csv.
#   append   keep the source field and add an xml:lang-marked sibling beside it,
#            following AMCR's own heslo/heslo_en convention. ALTO LABELS rather
#            than duplicates in this mode — per-String append is incoherent because
#            the word-to-box alignment is manufactured (see the digest).
# Shared with the CLI's --output-mode flag and config.txt's output_mode key.
# Append mode should be run with --xsd on its first real outing: whether the AMCR
# schema permits the repeated element is the open maxOccurs question, and the
# validator answers it.
OUTPUT_MODE=replace

# [operator] File listing the AMCR XPath targets translated in METADATA mode, one per
# line, '#' comments allowed. Relative paths resolve against the repo root inside the
# image (/app), where the Dockerfile's `COPY . .` already places amcr-fields.txt.
# The batch CLI reads the same list from config.txt's `fields =` key; the service uses
# an env var because its whole config surface is environment-based (12-factor III).
# With no readable file, ALTO requests are unaffected and metadata requests are
# refused with 422 rather than silently returning the document untranslated.
AMCR_FIELDS_PATH=amcr-fields.txt

# [operator] Connection, only when TRANSLATION_BACKEND=openai_compatible.
# LLM_API_KEY is a SECRET: keep it out of the image (.env is in both .gitignore and
# .dockerignore) and out of the k8s manifest — use a Secret.
# LLM_BASE_URL=https://api.example.org/v1
# LLM_MODEL=
# [secret]
# LLM_API_KEY=
# LLM_PROVIDER=
# LLM_LANGUAGES=              # CSV of language codes this backend may handle

# [operator] Transport, same shape as the LINDAT dials below. Rate-limits THIS
# deployment against a shared endpoint.
# LLM_MIN_INTERVAL_S=0.0      # minimum seconds between outbound requests
# LLM_MAX_RETRIES=4           # retries on network error / HTTP 429 / 5xx
# LLM_BACKOFF_BASE_S=1.0      # sleep = base * 2**attempt + jitter

# [operator] These shape HOW the LINDAT endpoint is called, not WHICH one — they are
# named for the shared public service they were tuned against and are unrelated to
# TRANSLATION_URL above. Rate-limits THIS deployment against a shared public service.
# LINDAT_MIN_INTERVAL_S=0.0   # minimum seconds between outbound requests
# LINDAT_MAX_RETRIES=4        # retries on network error / HTTP 429 / 5xx
# LINDAT_BACKOFF_BASE_S=1.0   # sleep = base * 2**attempt + jitter
# LINDAT_GUARD_RETRIES=2      # re-requests of an HTTP-200 reply that is degenerate (loop/empty/runaway)

# [operator] CTranslate2 self-host model, only when TRANSLATION_BACKEND=ct2 (needs
# requirements-ct2.txt installed; see docs/translation-backends.md). The compute type
# is checked against what CT2_DEVICE supports when the model loads.
# CT2_MODEL_DIR=              # path to the converted CTranslate2 model
# CT2_MODEL_FAMILY=eurollm    # eurollm | madlad | nllb | opus
# CT2_SP_MODEL=               # SentencePiece model path, when the family needs one
# CT2_DEVICE=cpu              # cpu | cuda
# CT2_COMPUTE_TYPE=int8       # int8 runs on every device; float16 etc. need cuda
# CT2_LANGUAGES=              # CSV of language codes this backend may handle

# ── §6 Completeness ledger — algorithmic, deprecated, unreachable ────────────────
# [algorithmic] Generation and OCR-faithfulness guards, only when
# TRANSLATION_BACKEND=openai_compatible. These bound what the model may return; a
# translation outside the length ratio is rejected rather than written into the XML,
# because a plausible-looking hallucination is worse than a failed chunk. Changes
# what the service COMPUTES, not how it is deployed.
# LLM_MAX_TOKENS=2048         # per-chunk generation cap (anti-truncation)
# LLM_MAX_GLOSSARY_TERMS=40   # vocabulary terms injected into the prompt
# LLM_GUARD_MIN_CHARS=16      # below this length the ratio guards do not apply
# LLM_GUARD_MIN_RATIO=0.25    # reject output shorter than 0.25x the source
# LLM_GUARD_MAX_RATIO=4.0     # reject output longer than 4x the source

# [algorithmic] The same output-faithfulness guards for TRANSLATION_BACKEND=ct2.
# CT2_GUARD_MIN_CHARS=16      # as LLM_GUARD_* above
# CT2_GUARD_MIN_RATIO=0.25
# CT2_GUARD_MAX_RATIO=4.0

# [algorithmic] Every backend. A segment (ALTO block, ALTO line anchor, metadata field)
# whose translation is still degenerate after the backend's own retries is FLAGGED and
# re-requested once the whole document has been processed; one that never recovers
# keeps its source text and is logged `untranslated` in the *_log.csv `status` column.
# Set the rounds to 0 to keep flagged segments as source without a re-run.
# TRANSLATION_RERUN_ROUNDS=1     # end-of-document re-run rounds for flagged segments
# TRANSLATION_RERUN_DELAY_S=10.0 # cool-down before each re-run round
