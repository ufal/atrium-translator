# atrium-translator — service-layer environment contract (atrium-project#60).
#
# Copy to `.env` and edit. docker-compose reads `.env` from the repo root
# automatically. Every variable `service/` reads is listed here; per-run knobs
# (input paths, formats, vocabulary) live in config.txt instead.

# ── Backing services (atrium-project#63) ──────────────────────────────────────
# Attachable endpoints: point these at a self-hosted translation service or
# UDPipe 2, or at a local stub, with no code change. Leave BLANK (not deleted)
# to use the LINDAT defaults — blank means "unset" to every resolver, which is
# why docker-compose.yml passes them as ${VAR:-}.
#
# TRANSLATION_URL is the documented name; LINDAT_BASE_URL is accepted as an
# alias and loses to it when both are set. Whichever resolves is what
# /translate and the batch CLI record in the `translation_api` paradata field,
# so the record always names the host the request actually went to.
TRANSLATION_URL=
# Used for vocabulary lemma matching (Tag-and-Protect). Same variable name as
# atrium-nlp-enrich, which calls the same service for its own pipeline.
UDPIPE_URL=

# Which translation backend to load. `lindat` (CUBBITT) is the default;
# `openai_compatible` needs the LLM_* variables below. Shared with the CLI's
# --backend flag (issue #4).
TRANSLATION_BACKEND=lindat

# ── LLM backend (only when TRANSLATION_BACKEND=openai_compatible) ─────────────
# LLM_BASE_URL=https://api.example.org/v1
# LLM_MODEL=
# LLM_API_KEY=
# LLM_PROVIDER=
# LLM_LANGUAGES=

# ── LINDAT transport tuning ───────────────────────────────────────────────────
# These shape HOW the LINDAT endpoint is called, not WHICH one — they are named
# for the shared public service they were tuned against and are unrelated to
# TRANSLATION_URL above.
# LINDAT_MIN_INTERVAL_S=0.0   # minimum seconds between outbound requests
# LINDAT_MAX_RETRIES=4        # retries on network error / HTTP 429 / 5xx
# LINDAT_BACKOFF_BASE_S=1.0   # sleep = base * 2**attempt + jitter

# ── Image / provenance ────────────────────────────────────────────────────────
# Image tag used by docker-compose (matches para_config.txt [tool] on release)
ATRIUM_VERSION=dev
# Stamped into paradata as runner_ref
ATRIUM_RUNNER_REF=dev

# ── HTTP surface ──────────────────────────────────────────────────────────────
# Port the api service binds, and the port service/healthcheck.py probes inside
# the container. docker-compose.yml maps "${PORT:-8000}:${PORT:-8000}", so
# changing it here moves listener, published port and HEALTHCHECK together.
PORT=8000
# Bind address. Leave at 0.0.0.0: healthcheck.py always probes loopback and never
# reads HOST, so 127.0.0.1 gives a container that reports healthy and is
# unreachable from outside it.
HOST=0.0.0.0
# CORS for the api profile
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5500
# Canonical upload limit. MAX_UPLOAD_BYTES is a DEPRECATED fallback kept for
# older callers (service/atrium_service.py prefers the MB form) — set this one.
MAX_UPLOAD_MB=50
# DEPRECATED — do not set. Kept only so older callers that exported it still
# work; MAX_UPLOAD_MB wins whenever both are present. Listed here so the
# contract is complete and the deprecation is discoverable, not to offer a
# second knob.
# MAX_UPLOAD_BYTES=
# Path the container's HEALTHCHECK probes; change only alongside the route.
HEALTHCHECK_PATH=/health

# ── Lifecycle ─────────────────────────────────────────────────────────────────
# Seconds uvicorn waits for in-flight requests on SIGTERM. A single /translate
# chunk can legitimately run for minutes; raise this together with the
# deployment's grace period (see docs/k8s_deployment.md in the hub).
GRACEFUL_SHUTDOWN_S=20
# Root logger level for the `python -m service.api` start path
LOG_LEVEL=INFO
# Filesystem auto-reload — development only, never in a deployment
RELOAD=false
